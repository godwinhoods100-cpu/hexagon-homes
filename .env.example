# Frontend
VITE_API_URL=http://localhost:8000/api

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443
CSRF_TRUSTED_ORIGINS=
# Leave DATABASE_URL commented out to use SQLite locally.
# Uncomment and edit it to use PostgreSQL (production).
# DATABASE_URL=postgresql://hexagon:password@localhost:5432/hexagon_homes
DB_SSLMODE=prefer
